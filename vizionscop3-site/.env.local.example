# Copy to .env.local and fill in values. Never commit .env.local.

# --- Email (Resend) — required in production for /api/contact ---
RESEND_API_KEY=
# Verified sender in Resend, e.g. "VizionScop3 <onboarding@resend.dev>"
RESEND_FROM_EMAIL=
# Inbox for contact form notifications (defaults to hello@vizionscop3.com if unset)
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile — optional; if set, widget is shown and token is verified ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry — optional; errors only reported when DSN is set ---
NEXT_PUBLIC_SENTRY_DSN=
# Server can use the same DSN or omit (falls back to NEXT_PUBLIC_SENTRY_DSN in sentry.server.config)
SENTRY_DSN=
# For CI source map upload (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Sanity CMS — optional; when project ID is set, list/detail pages use live content ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Draft/preview only (server)
SANITY_API_TOKEN=

# --- Analytics — optional ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

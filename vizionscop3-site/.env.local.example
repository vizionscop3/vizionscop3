# VizionScop3 V2 — see repo-root TRD §4.1
#
# Production (e.g. Vercel): contact API needs ALL of the following or submissions return 503:
#   NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   RESEND_API_KEY, RESEND_FROM_EMAIL, RESEND_TO_EMAIL
# Optional but recommended: NEXT_PUBLIC_HCAPTCHA_SITE_KEY + HCAPTCHA_SECRET_KEY
# (both required together in production builds for captcha verification to pass)

# Must include the scheme. Local: http://localhost:3000. Production: https://vizionscop3.com (your live domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VizionScop3

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
# Bare email or Resend-style: VizionScop3 <contact@vizionscop3.com>
RESEND_FROM_EMAIL=contact@vizionscop3.com
RESEND_TO_EMAIL=contact@vizionscop3.com

NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Cal.com — public profile username (screenshot: ceovizion → https://cal.com/ceovizion)
NEXT_PUBLIC_CAL_USERNAME=ceovizion
# Optional event slug for a direct embed/link (e.g. 30min). Omit to use the profile hub.
# NEXT_PUBLIC_CAL_EVENT_PATH=30min
# Optional: full booking URL override (wins over username + path)
# NEXT_PUBLIC_CAL_EMBED_URL=https://cal.com/ceovizion/30min

NEXT_PUBLIC_SENTRY_DSN=
